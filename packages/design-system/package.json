{
  "name": "@wideset/react",
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Wideset, the Widelab design system: React components, tokens and stylesheets",
  "keywords": [
    "react",
    "components",
    "design-system",
    "ui",
    "tailwindcss"
  ],
  "author": "Widelab",
  "repository": {
    "type": "git",
    "url": "https://github.com/widelab-co/wideset",
    "directory": "packages/design-system"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.mjs"
      },
      "require": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.cjs"
      }
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./preflight": {
      "types": "./dist/preflight.d.ts",
      "style": "./dist/preflight.css",
      "default": "./dist/preflight.css"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "style": "./dist/theme.css",
      "default": "./dist/theme.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode library",
    "build:dev": "tsc && vite build",
    "build:lib": "vite build --mode library",
    "build:lib:watch": "vite build --mode library --watch",
    "build:registry": "pnpm build:lib && node scripts/build-registry.mjs",
    "build:storybook": "pnpm build:registry && storybook build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx,.mjs",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test-watch": "vitest",
    "test:registry": "node scripts/registry-smoke.mjs",
    "playground": "node scripts/playground.mjs",
    "prefix-tokens": "node prefix-tokens.cjs",
    "generate-semantic-variables": "node generate-semantic-variables.cjs",
    "storybook": "storybook dev -p 6006",
    "chromatic": "chromatic --build-script-name=build:storybook"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-compose-refs": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "react-day-picker": "^9.11.1",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-links": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/builder-vite": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "chromatic": "^15.2.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.4.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^15.0.0",
    "react-router-dom": "^6.11.1",
    "shadcn": "4.21.1",
    "storybook": "^10.3.5",
    "storybook-dark-mode": "^5.0.0",
    "tailwindcss": "^4.1.17",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-radix": "^4.0.2",
    "typescript": "^5.0.4",
    "vite": "^7.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.0.10"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
