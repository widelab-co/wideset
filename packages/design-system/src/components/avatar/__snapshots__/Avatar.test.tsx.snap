// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Avatar > Snapshots > should match snapshot for a group with an overflow badge 1`] = `
<div>
  <div
    class="w-full is-group group -space-x-ws-4 isolate flex flex-nowrap items-center whitespace-nowrap [&>[data-slot=avatar]>:first-child]:outline-2 [&>[data-slot=avatar]>:first-child]:outline-ws-static-container"
    data-slot="avatar-group"
  >
    <span
      class="relative inline-flex"
      data-slot="avatar"
      style="z-index: 3;"
    >
      <span
        class="relative box-border inline-flex shrink-0 items-center justify-center object-cover typography-label-strong-sm h-ws-14 w-ws-14 [&_svg]:size-ws-9 [--mask-edge:0.5px] [--mask-position:6px] [--mask-radius:6px] rounded-full bg-ws-non-semantic-yellow-subtle text-ws-non-semantic-yellow-on-subtle"
        data-slot="avatar-initials"
      >
        WD
      </span>
    </span>
    <span
      class="relative inline-flex"
      data-slot="avatar"
      style="z-index: 2;"
    >
      <span
        class="relative box-border inline-flex shrink-0 items-center justify-center object-cover typography-label-strong-sm h-ws-14 w-ws-14 [&_svg]:size-ws-9 [--mask-edge:0.5px] [--mask-position:6px] [--mask-radius:6px] rounded-full bg-ws-non-semantic-indigo-subtle text-ws-non-semantic-indigo-on-subtle"
        data-slot="avatar-initials"
      >
        WD1
      </span>
    </span>
    <span
      class="cursor-default relative box-border inline-flex shrink-0 items-center justify-center text-ws-static-base transition-colors bg-ws-dynamic-secondary-alpha-strong-default typography-caption-strong-md h-ws-14 w-ws-14 [&_svg]:size-ws-9 rounded-full"
      data-slot="avatar-more"
      style="z-index: 1;"
    >
      +1
    </span>
  </div>
</div>
`;

