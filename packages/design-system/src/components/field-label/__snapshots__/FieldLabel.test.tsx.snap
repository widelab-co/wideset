exports[`FieldLabel > Snapshots > matches snapshot for a composed label row 1`] = `
<div>
  <label
    class="text-ws-static-strong typography-label-strong-sm gap-ws-3 inline-flex min-w-0 flex-wrap items-center"
    data-slot="field-label"
  >
    <span
      class="min-w-0 break-words"
    >
      Test Label 
      <span
        class="text-ws-static-subtle typography-label-sm shrink-0"
        data-slot="field-label-suffix"
      >
        (optional)
      </span>
    </span>
    <span
      aria-hidden="true"
      class="text-ws-semantic-negative typography-label-sm shrink-0"
      data-slot="field-label-required"
    >
      *
    </span>
  </label>
  <button
    aria-label="More information"
    class="text-ws-static-subtle focus-visible:wds-focus-visible inline-flex shrink-0 items-center justify-center rounded-full"
    data-slot="field-label-tooltip"
    data-state="closed"
    type="button"
  >
    <svg
      aria-hidden="true"
      class="remixicon h-ws-9 w-ws-9"
      fill="currentColor"
      focusable="false"
      height="24"
      viewBox="0 0 24 24"
      width="24"
      xmlns="http://www.w3.org/2000/svg"
    >
