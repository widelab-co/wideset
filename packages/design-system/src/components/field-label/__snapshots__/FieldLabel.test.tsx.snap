      />
    </svg>
  </button>
  <div
    class="text-ws-static-subtle typography-label-sm gap-ws-2 ml-auto flex shrink-0 items-center"
    data-slot="field-label-aside"
  >
    0/100
  </div>
  <p
    class="text-ws-static-subtle typography-body-md basis-full"
    data-slot="field-label-description"
  >
    This is a description
  </p>
</div>
`;

