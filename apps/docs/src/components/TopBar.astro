---
import { RiGithubLine, RiSearchLine } from '@remixicon/react';

import { AREAS, GITHUB_URL, STORYBOOK_URL, type Area } from '../lib/nav';
import ThemeToggle from './ThemeToggle';
import { WidesetWordmark } from './Wordmark';

interface Props {
  area: Area;
}
const { area } = Astro.props;

const tab = (active: boolean) =>
  [
    'flex h-ws-forms-sm items-center rounded-ws-control-md px-ws-7 typography-label-strong-sm transition-colors',
    active
      ? 'bg-ws-static-alpha-subtle text-ws-static-strong'
      : 'text-ws-static-subtle hover:text-ws-static-strong',
  ].join(' ');
---

<header class="docs-topbar fixed inset-x-0 top-0 z-30 flex h-ws-19 items-center gap-ws-11 px-ws-12">
  <a
    href="/docs/introduction"
    class="text-ws-static-strong flex items-center"
    aria-label="Wideset — home"
  >
    <WidesetWordmark width={90} />
  </a>
  <nav class="flex items-center gap-ws-2" aria-label="Sections">
    {AREAS.map((item) => (
      <a
        href={item.href}
        class={tab(item.id === area)}
        aria-current={item.id === area ? 'true' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
  <div class="ml-auto flex items-center gap-ws-5">
    {/* ds-exempt: a button dressed as a field; it opens the palette (SearchPalette). */}
    <button
      type="button"
      data-docs-search
      class="flex h-ws-forms-sm w-[15rem] items-center gap-ws-5 rounded-ws-control-lg border border-ws-static-subtle bg-ws-static-alpha-subtle px-ws-6 text-left typography-body-md text-ws-static-subtle hover:text-ws-static-base"
      aria-label="Search the documentation"
    >
      <RiSearchLine size={16} className="shrink-0" />
      <span class="min-w-0 flex-1 truncate">Search documentation…</span>
      <kbd class="rounded-ws-control-sm border border-ws-static-subtle px-ws-4 font-sans typography-caption-md text-ws-static-subtle">
        ⌘K
      </kbd>
    </button>
    <a
      href={STORYBOOK_URL}
      target="_blank"
      rel="noreferrer"
      class="text-ws-static-subtle hover:text-ws-static-strong hidden h-8 items-center rounded-md px-2 text-sm transition-colors sm:flex"
    >
      Storybook
    </a>
    <a
      href={GITHUB_URL}
      target="_blank"
      rel="noreferrer"
      class="text-ws-static-subtle hover:text-ws-static-strong flex size-ws-forms-sm items-center justify-center rounded-ws-control-md transition-colors"
      aria-label="Source on GitHub"
    >
      <RiGithubLine size={18} />
    </a>
    <ThemeToggle client:load />
  </div>
</header>
