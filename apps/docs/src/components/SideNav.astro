---
import { RiArrowDownSLine } from '@remixicon/react';

import type { NavSection } from '../lib/nav';

/**
 * The left column: one list per section, 32px rows on a 14px line. Hover is one highlight
 * (`.nav-pill`) that glides between the rows of a list instead of each row lighting up; the
 * inline script below positions it. The current row is marked and scrolled into view. A
 * family (Button › Icon button, Link button, …) folds under one row, open while one of its
 * members is the current page.
 */
interface Props {
  sections: NavSection[];
  current: string;
}
const { sections, current } = Astro.props;

const row = (active: boolean) =>
  [
    'relative z-10 flex h-ws-forms-sm items-center rounded-ws-control-md px-ws-7 typography-body-md transition-colors duration-[160ms]',
    active
      ? 'bg-ws-static-alpha-subtle text-ws-static-strong'
      : 'text-ws-static-subtle hover:text-ws-static-strong',
  ].join(' ');
const holds = (item: NavSection['items'][number]) =>
  item.children?.some((child) => child.href === current) ?? false;
---

<aside class="docs-scroll sticky top-[var(--docs-top)] hidden h-[calc(100vh-var(--docs-top))] w-[256px] shrink-0 overflow-y-auto px-ws-9 pt-ws-7 pb-ws-12 lg:block">
  {sections.map((section, index) => (
    <div class:list={[index > 0 && 'mt-ws-13']}>
      {section.label && (
        <div class="flex items-center pt-ws-5 pb-ws-4 pl-ws-7">
          <span class="text-ws-static-strong typography-caption-strong-md tracking-ws-wide-100 uppercase">
            {section.label}
          </span>
        </div>
      )}
      <nav
        class="relative flex flex-col gap-ws-2"
        aria-label={section.label ?? 'Documentation'}
        data-nav
      >
        <span class="nav-pill" aria-hidden="true"></span>
        {section.items.map((item) =>
          item.children ? (
            <details class="group" open={holds(item)}>
              <summary
                class={`${row(false)} cursor-pointer list-none justify-between [&::-webkit-details-marker]:hidden`}
              >
                {item.title}
                <RiArrowDownSLine className="size-ws-8 shrink-0 transition-transform duration-[160ms] group-open:rotate-180" />
              </summary>
              <div class="border-ws-static-subtle mt-ws-2 ml-ws-7 flex flex-col gap-ws-2 border-l pl-ws-4">
                {item.children.map((child) =>
                  child.href === current ? (
                    <span class={row(true)} aria-current="page">
                      {child.title}
                    </span>
                  ) : (
                    <a href={child.href} class={row(false)}>
                      {child.title}
                    </a>
                  ),
                )}
              </div>
            </details>
          ) : item.href === current ? (
            <span class={row(true)} aria-current="page">
              {item.title}
            </span>
          ) : (
            <a href={item.href} class={row(false)}>
              {item.title}
            </a>
          ),
        )}
      </nav>
    </div>
  ))}
</aside>

{/* Small screens: the same links, folded under the page title. */}
<details class="border-ws-static-subtle mb-ws-12 rounded-ws-container-md border lg:hidden">
  <summary class="text-ws-static-subtle cursor-pointer px-ws-9 py-ws-5 typography-body-md">
    Navigation
  </summary>
  <div class="border-ws-static-subtle border-t px-ws-5 py-ws-5">
    {sections.map((section) => (
      <nav class="flex flex-col gap-ws-2" aria-label={section.label ?? 'Documentation'}>
        {section.items
          .flatMap((item) => item.children ?? [item])
          .map((item) => (
            <a href={item.href} class={row(item.href === current)}>
              {item.title}
            </a>
          ))}
      </nav>
    ))}
  </div>
</details>

<script is:inline>
  // One hover highlight per list, gliding between rows. The first entry snaps into place
  // (no slide from the top); every move after that eases.
  (function () {
    document.querySelectorAll('[data-nav]').forEach(function (nav) {
      var pill = nav.querySelector('.nav-pill');
      if (!pill) return;
      nav.querySelectorAll('a, [aria-current], summary').forEach(function (row) {
        row.addEventListener('mouseenter', function () {
          var hidden = pill.style.opacity !== '1';
          if (hidden) pill.style.transition = 'none';
          pill.style.transform = 'translateY(' + row.offsetTop + 'px)';
          pill.style.height = row.offsetHeight + 'px';
          if (hidden) {
            void pill.offsetHeight;
            pill.style.transition = '';
          }
          pill.style.opacity = '1';
        });
      });
      nav.addEventListener('mouseleave', function () {
        pill.style.opacity = '0';
      });
    });
  })();
</script>
<script is:inline>
  // The navigation scrolls on its own; bring the current page's row into view.
  (function () {
    var row = document.querySelector('aside [aria-current="page"]');
    if (row && row.scrollIntoView) row.scrollIntoView({ block: 'center' });
  })();
</script>
