---
import { RiLink } from '@remixicon/react';

interface Props {
  id: string;
  level?: 2 | 3;
  tab?: string;
  label: string;
}

const { id, level = 2, tab, label } = Astro.props;
const Tag = level === 2 ? 'h2' : 'h3';
---

<Tag
  id={id}
  class:list={[
    'text-ws-static-strong scroll-mt-ws-21',
    level === 2 ? 'typography-subtitle-sm' : 'typography-label-strong-md',
  ]}
>
  <a class="docs-section-link" href={`${tab ? `?tab=${tab}` : ''}#${id}`}>
    {label}
    <RiLink aria-hidden="true" className="size-ws-9 shrink-0" />
  </a>
</Tag>
