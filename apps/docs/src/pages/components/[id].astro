---
import PropsTables from '../../components/PropsTables';
import PageHead from '../../components/PageHead.astro';
import { CopyPage, ExampleCard, Install, Rail, Stage } from '../../components/parts';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { entries, entryById, partsOf } from '../../lib/catalog';
import { examplesFor } from '../../lib/examples';
import { accessibilityContent } from '../../lib/guidance';
import { componentMarkdown } from '../../lib/markdown';
import { hasPlayground } from '../../lib/playground';
import { manualFiles, projectPaths } from '../../lib/registry';
import { componentsSidebar } from '../../lib/sidebar';

/**
 * A component page, kept simple: the title and description with Copy page, the component
 * on its stage, Installation, every example (title, description, a preview card with its code),
 * the API reference and Accessibility.
 */

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { id: entry.id } }));
}

const entry = entryById(Astro.params.id!)!;
const examples = examplesFor(entry.id);
const playground = hasPlayground(entry.id);
const parts = partsOf(entry);
const A11yNotes = accessibilityContent(entry.id);
const allPaths = projectPaths();
const used = new Set([
  ...entries.flatMap((item) => item.exports),
  ...examples.flatMap((example) =>
    [...example.code.matchAll(/import\s*\{([^}]*)\}\s*from\s*'@wideset\/react'/g)].flatMap(
      ([, list]) => list.split(',').map((name) => name.trim()),
    ),
  ),
]);
const paths = Object.fromEntries(Object.entries(allPaths).filter(([name]) => used.has(name)));

const rail = [
  { id: 'installation', label: 'Installation' },
  examples.length > 0 && { id: 'examples', label: 'Examples' },
  ...examples.map((example) => ({
    id: `example-${example.name}`,
    label: example.title,
    indent: true,
  })),
  { id: 'api', label: 'API reference' },
  A11yNotes && { id: 'accessibility', label: 'Accessibility' },
].filter((item): item is { id: string; label: string; indent?: boolean } => Boolean(item));
const searchSections = rail
  .filter((item) => !item.indent)
  .map((item) => ({
    title: item.label,
    href: `/components/${entry.id}#${item.id}`,
    group: entry.title,
  }));

const h2 = 'text-ws-static-strong scroll-mt-ws-21 typography-subtitle-sm';
const section = 'mt-ws-21';
---

<DocsLayout
  title={entry.title}
  description={entry.description ?? entry.title}
  area="components"
  nav={componentsSidebar()}
  current={`/components/${entry.id}`}
  search="Search components…"
  sections={searchSections}
>
  <PageHead title={entry.title} description={entry.description ?? 'Description pending.'}>
    <CopyPage slot="actions" markdown={componentMarkdown(entry)} client:idle />
  </PageHead>

  {playground && (
    <div data-playground={entry.id}>
      <Stage component={entry.id} client:load />
    </div>
  )}

  <section class={playground ? section : undefined}>
    <h2 id="installation" class={h2}>
      Installation
    </h2>
    <div class="mt-ws-9">
      <Install id={entry.id} files={manualFiles(entry.id)} client:idle />
    </div>
  </section>

  {examples.length > 0 && (
    <section class={section}>
      <h2 id="examples" class={h2}>
        Examples
      </h2>
      <div class="mt-ws-9 flex flex-col gap-ws-17">
        {examples.map((example) => (
          <div>
            <h3
              id={`example-${example.name}`}
              class="text-ws-static-strong scroll-mt-ws-21 typography-label-strong-md"
            >
              {example.title}
            </h3>
            {example.caption && (
              <p class="text-ws-static-subtle mt-ws-4 max-w-[65ch] typography-body-md">
                {example.caption.replace(/`/g, '')}
              </p>
            )}
            <div class="mt-ws-9">
              <ExampleCard file={example.file} code={example.code} paths={paths} client:visible />
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class={section}>
    <h2 id="api" class={h2}>
      API reference
    </h2>
    <div class="mt-ws-9">
      <PropsTables
        parts={parts.map((part) => ({
          part: part.part,
          element: part.table.element,
          rows: part.table.props,
        }))}
        client:idle
      />
    </div>
  </section>

  {A11yNotes && (
    <section class={section}>
      <h2 id="accessibility" class={h2}>
        Accessibility
      </h2>
      <div class="docs-prose !max-w-none mt-ws-5">
        <A11yNotes />
      </div>
    </section>
  )}

  <Rail slot="rail" items={rail} client:load />
</DocsLayout>
