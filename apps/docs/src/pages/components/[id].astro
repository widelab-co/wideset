---
import AnatomyDiagram from '../../components/AnatomyDiagram';
import RegistryCode from '../../components/RegistryCode';
import PageHead from '../../components/PageHead.astro';
import { CopyPage, ExampleCard, Install, PageTabs, Rail, Stage } from '../../components/parts';
import PropsTables from '../../components/PropsTables';
import RelationshipGraph from '../../components/RelationshipGraph';
import SectionHeading from '../../components/SectionHeading.astro';
import Workbench from '../../components/Workbench';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { entries, entryById, partsOf, relationsOf, relationships } from '../../lib/catalog';
import { examplesFor } from '../../lib/examples';
import { accessibilityContent } from '../../lib/guidance';
import { kebab } from '../../lib/kebab';
import { componentMarkdown, describePart } from '../../lib/markdown';
import { hasPlayground, PLAYGROUNDS } from '../../lib/playground';
import { manualFiles, projectPaths } from '../../lib/registry';
import { componentsSidebar } from '../../lib/sidebar';

/**
 * A component page: the title and description with Copy page, then tabs whose
 * content switches in place.
 *
 * - Overview: the component on its stage, Installation, every example (title, description, a
 *   preview card with its code), the API reference and Accessibility.
 * - Anatomy: the component drawn 1:1 with each part named beside it, then the parts as a table.
 *   Only for a component with two or more parts whose playground does not say `anatomy: false`.
 * - Relationships: the map of what the component is built with and appears beside, then the
 *   same as lists. Only for a component the graph links to another.
 * - Code: the component's installable source files.
 * - Playground: a live example with editable props and its generated code.
 *
 * A component with only Overview has no tab row. Every panel is in the HTML; `html[data-tab]`,
 * set from the address before first paint, shows one (docs.css), and each tab has its own rail.
 */
export function getStaticPaths() {
  return entries.map((entry) => ({ params: { id: entry.id } }));
}

const entry = entryById(Astro.params.id!)!;
const examples = examplesFor(entry.id);
const playground = hasPlayground(entry.id);
const files = manualFiles(entry.id);
const parts = partsOf(entry);
const root = entry.exports[0];
const A11yNotes = accessibilityContent(entry.id);
const allPaths = projectPaths();
const used = new Set([
  ...entries.flatMap((item) => item.exports),
  ...examples.flatMap((example) =>
    [...example.code.matchAll(/import\s*\{([^}]*)\}\s*from\s*'@wideset\/react'/g)].flatMap(
      ([, list]) => list.split(',').map((name) => name.trim()),
    ),
  ),
]);
const paths = Object.fromEntries(Object.entries(allPaths).filter(([name]) => used.has(name)));

/** The picture draws `anatomy()`, or the gallery preview, or the playground stage. */
const picture = Boolean(PLAYGROUNDS[entry.id]);
const hasAnatomy = parts.length > 1 && PLAYGROUNDS[entry.id]?.anatomy !== false;
const relations = relationsOf(entry.id);
const relationLists = [
  { id: 'built-with', label: 'Built with', items: relations.builtWith },
  { id: 'used-by', label: `Uses ${entry.title}`, items: relations.usedBy },
  { id: 'appears-with', label: 'Appears with', items: relations.appearsWith },
].filter((list) => list.items.length > 0);
const hasRelations = relationLists.length > 0;

const tabs = [
  { id: 'overview', label: 'Overview' },
  hasAnatomy && { id: 'anatomy', label: 'Anatomy' },
  hasRelations && { id: 'relationships', label: 'Relationships' },
  files.own.length > 0 && { id: 'code', label: 'Code' },
  playground && { id: 'playground', label: 'Playground' },
].filter((tab): tab is { id: string; label: string } => Boolean(tab));
const tabbed = tabs.length > 1;

type RailItem = { id: string; label: string; indent?: boolean };
const rails: Record<string, RailItem[]> = {
  overview: [
    { id: 'installation', label: 'Installation' },
    examples.length > 0 && { id: 'examples', label: 'Examples' },
    ...examples.map((example) => ({
      id: `example-${example.name}`,
      label: example.title,
      indent: true,
    })),
    { id: 'api', label: 'API reference' },
    A11yNotes && { id: 'accessibility', label: 'Accessibility' },
  ].filter((item): item is RailItem => Boolean(item)),
  // One section each way: no rail.
  anatomy: [],
  relationships: [{ id: 'map', label: 'Map' }, ...relationLists],
  code: [],
  playground: [],
};
const page = `/components/${entry.id}`;
const searchSections = [
  ...rails.overview
    .filter((item) => !item.indent)
    .map((item) => ({ title: item.label, href: `${page}#${item.id}` })),
  ...tabs.slice(1).map((tab) => ({ title: tab.label, href: `${page}?tab=${tab.id}` })),
].map((item) => ({ ...item, group: entry.title }));

const section = 'mt-ws-21';
const text = 'text-ws-static-subtle mt-ws-4 max-w-[65ch] typography-body-md';
const th = 'text-ws-static-subtle px-ws-9 py-ws-6 text-left typography-caption-strong-md';
const td = 'px-ws-9 py-ws-8 align-top';
---

<DocsLayout
  title={entry.title}
  description={entry.description ?? entry.title}
  area="components"
  nav={componentsSidebar()}
  current={page}
  search="Search components…"
  sections={searchSections}
>
  <script
    // Before first paint. An address of the earlier page (`#install`, `#props`, `#anatomy`, …)
    // becomes the one that replaced it; then the tab in the address picks the panel, so nothing
    // flashes.
    is:inline
    slot="head"
    define:vars={{ ids: tabs.slice(1).map((tab) => tab.id) }}
  >
    var moveAnchor = function () {
      var old = location.hash.slice(1);
      var moved = { install: '#installation', props: '#api', usage: '' };
      var tabs = { anatomy: 'anatomy', related: 'relationships', playground: 'playground' };
      if (!Object.hasOwn(moved, old) && !Object.hasOwn(tabs, old)) return false;
      var url = new URL(location.href);
      url.hash = moved[old] || '';
      if (ids.includes(tabs[old])) url.searchParams.set('tab', tabs[old]);
      else url.searchParams.delete('tab');
      history.replaceState(history.state, '', url);
      return true;
    };
    moveAnchor();
    addEventListener('hashchange', function () {
      if (!moveAnchor()) return;
      dispatchEvent(new PopStateEvent('popstate'));
      document.getElementById(location.hash.slice(1))?.scrollIntoView();
    });
    var tab = new URLSearchParams(location.search).get('tab');
    if (ids.includes(tab)) document.documentElement.dataset.tab = tab;
  </script>
  <PageHead title={entry.title} description={entry.description ?? 'Description pending.'}>
    <CopyPage slot="actions" markdown={componentMarkdown(entry)} client:idle />
  </PageHead>

  {tabbed && <PageTabs tabs={tabs} client:load />}

  <div
    data-tab-panel="overview"
    id="panel-overview"
    role={tabbed ? 'tabpanel' : undefined}
    aria-labelledby={tabbed ? 'tab-overview' : undefined}
  >
    {playground && (
      <div data-playground={entry.id}>
        <Stage component={entry.id} client:load />
      </div>
    )}

    <section class={playground ? section : undefined}>
      <SectionHeading id="installation" label="Installation" />
      <div class="mt-ws-9">
        <Install id={entry.id} files={files} client:idle />
      </div>
    </section>

    {examples.length > 0 && (
      <section class={section}>
        <SectionHeading id="examples" label="Examples" />
        <div class="mt-ws-9 flex flex-col gap-ws-17">
          {examples.map((example) => (
            <div>
              <SectionHeading id={`example-${example.name}`} level={3} label={example.title} />
              {example.caption && <p class={text}>{example.caption.replace(/`/g, '')}</p>}
              <div class="mt-ws-9">
                <ExampleCard file={example.file} code={example.code} paths={paths} client:visible />
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class={section}>
      <SectionHeading id="api" label="API reference" />
      <div class="mt-ws-9">
        <PropsTables
          parts={parts.map((part) => ({
            part: part.part,
            element: part.table.element,
            rows: part.table.props,
          }))}
          client:idle
        />
      </div>
    </section>

    {A11yNotes && (
      <section class={section}>
        <SectionHeading id="accessibility" label="Accessibility" />
        <div class="docs-prose !max-w-none mt-ws-5">
          <A11yNotes />
        </div>
      </section>
    )}
  </div>

  {hasAnatomy && (
    <div data-tab-panel="anatomy" id="panel-anatomy" role="tabpanel" aria-labelledby="tab-anatomy">
      {picture && (
        <AnatomyDiagram
          component={entry.id}
          root={root}
          parts={parts.map((part, index) => ({
            n: index + 1,
            slot: kebab(part.exportName),
            exportName: part.exportName,
            part: part.part,
            element: part.table.element,
          }))}
          client:visible
        />
      )}
      {/* A container: in a narrow one the Renders column steps aside so descriptions keep room. */}
      <div class:list={['docs-card @container overflow-x-auto', picture && 'mt-ws-14']}>
        <table aria-label="Parts" class="w-full border-collapse typography-body-md">
          <thead>
            <tr class="border-ws-static-base border-b">
              <th class={th}>Part</th>
              <th class={`${th} @max-[36rem]:hidden`}>Renders</th>
              <th class={th}>Description</th>
            </tr>
          </thead>
          <tbody>
            {parts.map((part, index) => (
              <tr
                class="border-ws-static-base border-b transition-colors duration-(--ws-motion-duration-micro) ease-out last:border-b-0 data-[anatomy-active]:bg-ws-static-alpha-base"
                data-anatomy-row={picture ? kebab(part.exportName) : undefined}
              >
                {/* With a picture the part column is a tree: AnatomyDiagram sets --anatomy-depth. */}
                <td
                  class={`${td} text-ws-static-strong whitespace-nowrap`}
                  style={
                    picture ? 'padding-left: calc(var(--anatomy-depth, 0) * 1.25rem)' : undefined
                  }
                >
                  {part.part}
                  {picture && (
                    // Shown by the picture for a part it has nothing to point at: a provider,
                    // a portal, or a part that appears only in another state.
                    <span
                      data-anatomy-absent
                      hidden
                      class="text-ws-static-subtle block typography-caption-md"
                    >
                      {PLAYGROUNDS[entry.id]?.absent?.[part.exportName] ?? 'Renders no element'}
                    </span>
                  )}
                </td>
                <td class={`${td} text-ws-static-subtle whitespace-nowrap @max-[36rem]:hidden`}>
                  {part.table.element ?? '—'}
                </td>
                <td class={`${td} text-ws-static-subtle`}>{describePart(entry, index) || '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  {hasRelations && (
    <div
      data-tab-panel="relationships"
      id="panel-relationships"
      role="tabpanel"
      aria-labelledby="tab-relationships"
    >
      <div id="map" class="scroll-mt-ws-21">
        <RelationshipGraph
          current={entry.id}
          graph={relationships}
          pages={entries.map((item) => item.id)}
          client:visible
        />
      </div>
      {relationLists.map((list) => (
        <section class={section}>
          <SectionHeading id={list.id} label={list.label} tab="relationships" />
          <ul class="mt-ws-9 flex flex-wrap gap-ws-5">
            {list.items.map((item) => (
              <li>
                <a
                  href={`/components/${item.id}`}
                  class="border-ws-static-subtle text-ws-static-strong hover:bg-ws-static-alpha-subtle outline-ws-dynamic-primary-strong-default focus-visible:wds-focus-visible rounded-ws-control-full px-ws-7 py-ws-3 typography-label-sm block border no-underline transition-colors"
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}

  {files.own.length > 0 && (
    <div data-tab-panel="code" id="panel-code" role="tabpanel" aria-labelledby="tab-code">
      <RegistryCode
        directory={files.own[0].path.split('/').slice(0, -1).join('/')}
        files={files.own}
        client:visible
      />
    </div>
  )}

  {playground && (
    <div
      data-tab-panel="playground"
      id="panel-playground"
      role="tabpanel"
      aria-labelledby="tab-playground"
    >
      <Workbench component={entry.id} paths={allPaths} tabbed client:visible />
    </div>
  )}

  <Fragment slot="rail">
    {tabs.map(
      (tab) =>
        rails[tab.id].length > 1 && (
          <div data-tab-panel={tab.id}>
            <Rail items={rails[tab.id]} client:load />
          </div>
        ),
    )}
  </Fragment>
</DocsLayout>
