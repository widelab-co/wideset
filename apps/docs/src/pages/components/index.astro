---
import Thumbnail from '../../components/Thumbnail';
import PageHead from '../../components/PageHead.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { entries } from '../../lib/catalog';
import { componentsSidebar } from '../../lib/sidebar';

/** All components: each component's thumbnail on the soft stage, three across. */
const sorted = [...entries].sort((a, b) => a.title.localeCompare(b.title));
---

<DocsLayout
  title="Components"
  description={`${entries.length} components, read from the package.`}
  area="components"
  nav={componentsSidebar()}
  current="/components"
  search="Search components…"
  broad
>
  <PageHead
    title="Components"
    description={`${entries.length} components the package exports, each with its examples, props and install line.`}
  />
  <ul class="grid grid-cols-2 gap-x-ws-11 gap-y-ws-14 xl:grid-cols-3">
    {sorted.map((entry) => (
      <li data-playground={entry.id}>
        <a href={`/components/${entry.id}`} class="group flex flex-col gap-ws-6 no-underline">
          <div class="flex h-[12rem]">
            <Thumbnail component={entry.id} client:idle />
          </div>
          <span class="text-ws-static-strong typography-label-strong-sm group-hover:underline">
            {entry.title}
          </span>
        </a>
      </li>
    ))}
  </ul>
</DocsLayout>
