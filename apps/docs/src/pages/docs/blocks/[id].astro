---
import { BlockFrame } from '../../../components/blocks';
import PageHead from '../../../components/PageHead.astro';
import { ButtonLink, Code, CopyPage, Crumbs } from '../../../components/parts';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { blockById, blockCategories, blocks, blockSource, shot } from '../../../lib/blocks';

/**
 * A block, the window's full width (no sidebar, no rail): a breadcrumb with its category, the
 * title and description, then the block.
 *
 * A block the library has (`packages/design-system/src/blocks/<id>/`) is live: its full-screen
 * route in a frame, clickable, in the page's theme, and its entry file under it. One it does
 * not have yet shows its screenshot (the light one, or the dark one on the dark page) and says
 * where the source is.
 */
export function getStaticPaths() {
  return blocks.map((block) => ({ params: { id: block.id } }));
}

const PULLS = [80, 81].map((number) => ({
  number,
  href: `https://github.com/widelab-co/wideset/pull/${number}`,
}));

const block = blockById(Astro.params.id!)!;
const category = blockCategories.find((item) => item.label === block.category)!;
const source = blockSource(block.id);
const markdown = [
  `# ${block.title}`,
  block.description,
  source ? `\`\`\`tsx\n${source.trimEnd()}\n\`\`\`` : '',
]
  .filter(Boolean)
  .join('\n\n')
  .concat('\n');
const h2 = 'text-ws-static-strong scroll-mt-ws-21 typography-subtitle-sm';
const text = 'text-ws-static-subtle mt-ws-4 max-w-[65ch] typography-body-md';
---

<DocsLayout title={block.title} description={block.description} area="blocks" broad full>
  <div class="mb-ws-9 -ml-ws-5">
    <Crumbs
      crumbs={[
        { label: 'Blocks', href: '/docs/blocks' },
        { label: category.label, href: `/docs/blocks#${category.slug}` },
      ]}
      title={block.title}
    />
  </div>
  <PageHead title={block.title} description={block.description}>
    {block.live && (
      <ButtonLink slot="actions" href={`/docs/blocks/${block.id}/full`}>
        Open full screen
      </ButtonLink>
    )}
    <CopyPage slot="actions" markdown={markdown} twin={false} client:idle />
  </PageHead>

  {block.live ? (
    <div class="border-ws-static-subtle bg-ws-static-alpha-subtle h-[max(45rem,calc(100dvh-16rem))] overflow-hidden rounded-ws-container-md border">
      <BlockFrame id={block.id} title={block.title} client:load />
    </div>
  ) : (
    <div class="border-ws-static-subtle bg-ws-static-alpha-subtle overflow-hidden rounded-ws-container-md border">
      <img
        src={shot(block.id, 'light')}
        alt={`${block.title}, a screenshot`}
        width="1440"
        height="960"
        class="docs-shot-light block h-auto w-full"
      />
      <img
        src={shot(block.id, block.dark ? 'dark' : 'light')}
        alt={`${block.title}, a screenshot`}
        width="1440"
        height="960"
        class="docs-shot-dark block h-auto w-full"
      />
    </div>
  )}

  <section class="mt-ws-21 max-w-[60rem]">
    <h2 id="code" class={h2}>
      Code
    </h2>
    {source ? (
      <>
        <p class:list={[text, 'mb-ws-9']}>
          The screen's entry file; its parts sit beside it in the block's folder.
        </p>
        <Code code={source} peek client:visible />
      </>
    ) : (
      <p class={text}>
        The source ships with the blocks; see the pull requests{' '}
        {PULLS.map((pull, index) => (
          <>
            {index > 0 && ' and '}
            <a href={pull.href} class="text-ws-static-strong underline underline-offset-[3px]">
              #{pull.number}
            </a>
          </>
        ))}
        . Once they are merged, this page shows the block live.
      </p>
    )}
  </section>
</DocsLayout>
