---
import '@fontsource-variable/inter';
import '@wideset/react/styles';
import '../../../../styles/block.css';

import { BlockView } from '../../../../components/blocks';
import { blockById, blocks } from '../../../../lib/blocks';
import { THEME_KEY } from '../../../../lib/theme';

/**
 * A block full screen: the library's component itself at 100vw × 100vh, in the docs' theme. The
 * block's page frames this route, so the block has a viewport of its own. Only the blocks the
 * library has get the route (none while `packages/design-system/src/blocks/` is not there).
 */
export function getStaticPaths() {
  return blocks.filter((block) => block.live).map((block) => ({ params: { id: block.id } }));
}

const block = blockById(Astro.params.id!)!;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{block.title} — Wideset blocks</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/_docs/favicon.png" />
    <script is:inline define:vars={{ THEME_KEY }}>
      try {
        var saved = localStorage.getItem(THEME_KEY);
        var dark =
          saved === 'dark' ||
          ((saved === 'system' || !saved) && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      } catch (e) {}
    </script>
  </head>
  <body>
    <BlockView id={block.id} back={`/docs/blocks/${block.id}`} client:only="react" />
  </body>
</html>
