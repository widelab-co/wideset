---
// Poppins (open, OFL) for the Lime preset's specimen and components, served from the site
// itself and loaded on this page only; the other brand fonts are proprietary and stand in as
// Inter.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';

import PageHead from '../../components/PageHead.astro';
import Themes from '../../components/Themes';
import DocsLayout from '../../layouts/DocsLayout.astro';

/** The theme customiser, in the shell every page has. */
---

<DocsLayout title="Themes" description="Make Wideset your own." area="themes" broad>
  <PageHead
    title="Themes"
    description="Make it yours, keep the foundation: a brand preset sets the colour, the corners and the font, and every component follows."
  />
  <Themes client:load />
</DocsLayout>
