---
import BlockCode from '../../components/BlockCode';
import { BlockLiveFrame } from '../../components/BlockPreviewFrame';
import PageHead from '../../components/PageHead.astro';
import { ButtonLink, CopyPage, Crumbs, PageTabs } from '../../components/parts';
import DocsLayout from '../../layouts/DocsLayout.astro';
import {
  blockById,
  blockCategories,
  blockMarkdown,
  DIRECTION_SUMMARY,
  DIRECTION_TITLE,
  ENTRIES,
  filesOf,
  inlineCode,
  isScreen,
  NAVIGATION_TITLE,
  PANEL_SUMMARY,
} from '../../lib/blocks';

/**
 * A block, the window's full width (no sidebar, no rail): a breadcrumb with its category, the
 * title and description, then two tabs. Preview: the block live in one frame (its preview route,
 * clickable, in the page's theme), its direction and navigation in one line. Code: how to use the
 * folder, then its files one at a time (BlockCode). The tab is in the address (`?tab=code`;
 * Preview has none), as on a component page.
 */
export function getStaticPaths() {
  return ENTRIES.map((block) => ({ params: { id: block.id } }));
}

const block = blockById(Astro.params.id!)!;
const category = blockCategories.find((item) => item.blocks.includes(block))!;
const files = filesOf(block.id);
const summary = isScreen(block) ? DIRECTION_SUMMARY[block.direction] : PANEL_SUMMARY;
const use = isScreen(block)
  ? 'Copy the folder into your app, keep the surround (the root element, the navigation and `main`) and replace the content and `data.ts`.'
  : 'Copy the folder into your app, render the panel from the screen that opens it and replace its content and `data.ts`.';
const markdown = blockMarkdown(block, Astro.site ?? new URL('https://wideset.co'));
const code = 'text-ws-static-base font-mono';
const tabs = [
  { id: 'preview', label: 'Preview' },
  { id: 'code', label: `Code · ${files.length} ${files.length === 1 ? 'file' : 'files'}` },
];
---

<DocsLayout title={block.title} description={block.description} area="blocks" broad full>
  <div class="mb-ws-9 -ml-ws-5">
    <Crumbs
      crumbs={[
        { label: 'Blocks', href: '/blocks' },
        { label: category.label, href: `/blocks#${category.slug}` },
      ]}
      title={block.title}
    />
  </div>
  <PageHead title={block.title} description={block.description}>
    <ButtonLink slot="actions" href={`/blocks/${block.id}/preview`} newTab>
      Open full screen
    </ButtonLink>
    <CopyPage slot="actions" markdown={markdown} client:idle />
  </PageHead>

  <script
    // Before first paint: the tab in the address picks the panel, so nothing flashes. The earlier
    // page's `#code` anchor opens the Code tab.
    is:inline
    slot="head"
  >
    if (location.hash === '#code') {
      var url = new URL(location.href);
      url.hash = '';
      url.searchParams.set('tab', 'code');
      history.replaceState(null, '', url);
    }
    if (new URLSearchParams(location.search).get('tab') === 'code')
      document.documentElement.dataset.tab = 'code';
  </script>
  <PageTabs tabs={tabs} client:load />

  <div data-tab-panel="preview" id="panel-preview" role="tabpanel" aria-labelledby="tab-preview">
    <div class="border-ws-static-subtle bg-ws-static-foreground h-[max(45rem,calc(100dvh-16rem))] overflow-hidden rounded-ws-container-md border">
      <BlockLiveFrame id={block.id} title={block.title} client:only="react" />
    </div>
    <p class="text-ws-static-subtle mt-ws-7 max-w-[60rem] typography-body-sm">
      {isScreen(block) && (
        <span class="text-ws-static-base">
          {DIRECTION_TITLE[block.direction]} · {NAVIGATION_TITLE[block.navigation]}.{' '}
        </span>
      )}
      {inlineCode(summary).map((part) =>
        part.code ? <code class={code}>{part.text}</code> : part.text,
      )}
    </p>
  </div>

  <div data-tab-panel="code" id="panel-code" role="tabpanel" aria-labelledby="tab-code">
    <p class="text-ws-static-subtle mb-ws-9 max-w-[65ch] typography-body-md">
      {inlineCode(use).map((part) =>
        part.code ? <code class={code}>{part.text}</code> : part.text,
      )}
    </p>
    <BlockCode files={files} client:load />
  </div>
</DocsLayout>
