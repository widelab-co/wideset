---
import '@fontsource-variable/inter';
import '@wideset/react/styles';
import '../styles/docs.css';
import '../generated/light-scope.css';

import SearchPalette from '../components/SearchPalette';
import SideNav from '../components/SideNav.astro';
import TopBar from '../components/TopBar.astro';
import { areaOf, componentsNav, docsNav, type NavSection } from '../lib/nav';
import { RADIUS_KEY } from '../lib/radius';
import { searchItems } from '../lib/search';
import { THEME_KEY } from '../lib/theme';

/**
 * The frame every page shares: a fixed top bar with the areas, a left column with the
 * area's navigation, a reading column, then "On this page" (the `toc` slot) and on component
 * pages a right rail (the `rail` slot). "On this page" takes no width: its ticks sit in the reading
 * column's right margin, so the column stays centred. The rail is fixed and the reading column
 * keeps its room with a margin: the rail comes last in the HTML, so a column that made room for
 * it only once it arrived would paint centred in the whole window first and then jump left. Pages pass a title and description; the layout works out the area and the current
 * row from the URL.
 */
interface Props {
  title: string;
  description: string;
  /** Wider reading column, for index pages that lay content out in a grid. */
  wide?: boolean;
  /** No max width outside the frame; in it, a page with no "On this page" (the gallery). */
  full?: boolean;
  /**
   * The components frame: every page in it reads at the same width (56rem). The right panel's
   * column is there only when the page fills it, so a page without one centres in the window
   * instead of beside an empty column.
   */
  frame?: boolean;
  /** Keep the page out of search results (and the sitemap): e.g. a component with no description yet. */
  noindex?: boolean;
}
const {
  title,
  description,
  wide = false,
  full = false,
  frame = false,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const area = areaOf(pathname);
const sections: NavSection[] =
  area === 'docs' ? await docsNav() : area === 'components' ? componentsNav() : [];
const hasRail = Astro.slots.has('rail');
/**
 * The reading column is centred in the space between the left column and the right one, so the
 * whitespace on its two sides is the same at every width (as in the prototype). Component pages
 * and the gallery read up to 56rem, so the gallery's cards keep a card's proportions.
 */
const gallery = frame && full;
const hasToc = (frame && !gallery) || Astro.slots.has('toc');

/**
 * SEO head. `site` is DOCS_URL: https://wideset.co when built for the shared domain, where the
 * edge serves these pages; the canonical, Open Graph and breadcrumbs all use it.
 */
const site = Astro.site ?? new URL('https://wideset-docs.widelab.workers.dev');
const canonical = new URL(pathname, site).href;
const fullTitle = `${title} — Wideset`;
const markdown = /^\/(docs|components)\/[^/]+$/.test(pathname) ? `${pathname}.md` : null;
const crumbs = [
  { name: 'Wideset', url: new URL('/', site).href },
  area === 'components'
    ? { name: 'Components', url: new URL('/components', site).href }
    : { name: 'Docs', url: new URL('/docs/introduction', site).href },
  { name: title, url: canonical },
].filter((crumb, index, all) => all.findIndex((other) => other.url === crumb.url) === index);
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: crumb.url,
  })),
};
const items = await searchItems();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* The workers.dev address is temporary; a custom domain (DOCS_URL) is indexed. */}
    {(noindex || Astro.site?.hostname.endsWith('.workers.dev')) && (
      <meta name="robots" content="noindex" />
    )}
    <link rel="canonical" href={canonical} />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Wideset" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
    <link rel="icon" href="/favicon.png" />
    <script is:inline define:vars={{ THEME_KEY, RADIUS_KEY }}>
      // Appearance before first paint. Same keys and rules as src/lib/theme.ts and radius.ts.
      // On wideset.co the shared shell has already set data-theme (its cookie or the system's
      // choice, before this script); that wins, so the docs open in the theme the landing had.
      try {
        var shell = document.documentElement.getAttribute('data-theme');
        var saved = localStorage.getItem(THEME_KEY);
        var dark =
          shell === 'dark' ||
          (!shell &&
            (saved === 'dark' ||
              ((saved === 'system' || !saved) &&
                matchMedia('(prefers-color-scheme: dark)').matches)));
        document.documentElement.classList.toggle('dark', dark);
        if (shell === 'light' || shell === 'dark') localStorage.setItem(THEME_KEY, shell);
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen">
    {/*
      Site contract: on wideset.co the edge replaces this element with the shared header (and
      the footer below with the shared footer). The top bar inside is what the docs show on
      their own, without the edge.
    */}
    <wideset-header>
      <TopBar area={area} />
    </wideset-header>
    <SearchPalette items={items} client:load />
    <div class="docs-shell-offset flex min-h-screen">
      {sections.length > 0 && <SideNav sections={sections} current={pathname} />}
      <main
        class:list={[
          'flex min-w-0 flex-1 justify-center px-ws-12 pt-ws-18 pb-ws-24 sm:px-ws-16',
          hasRail && 'xl:mr-[296px]',
        ]}
      >
        <div
          class:list={[
            'w-full min-w-0',
            frame ? 'max-w-[56rem]' : full ? '' : wide ? 'max-w-[64rem]' : 'max-w-[43rem]',
          ]}
        >
          <slot />
        </div>
      </main>
      {hasToc && (
        <aside
          class:list={[
            'fixed top-[var(--docs-top)] z-10 hidden h-[calc(100vh-var(--docs-top))] w-0 xl:block',
            hasRail ? 'right-[296px]' : 'right-0',
          ]}
        >
          <div class="absolute top-ws-18 right-ws-9">
            <slot name="toc" />
          </div>
        </aside>
      )}
      {hasRail && (
        <aside class="fixed top-[var(--docs-top)] right-0 hidden h-[calc(100vh-var(--docs-top))] w-[296px] pt-ws-11 pr-ws-12 xl:block">
          <div class="docs-scroll flex max-h-full flex-col gap-ws-7 overflow-y-auto pb-ws-12">
            <slot name="rail" />
            <a
              href="https://widelab.co"
              class="docs-rail text-ws-static-subtle hover:text-ws-static-strong flex h-ws-17 items-center justify-center rounded-ws-container-lg px-ws-9 typography-body-md transition-colors"
            >
              Built by Widelab
            </a>
          </div>
        </aside>
      )}
    </div>
    <wideset-footer></wideset-footer>
    <script>
      import '../lib/site-contract';
    </script>
  </body>
</html>
