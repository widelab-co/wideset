---
import '@fontsource-variable/inter';
import '@wideset/react/styles';
import '../styles/docs.css';
import '../generated/light-scope.css';

import type { SearchItem } from '../components/SearchPalette';
import { type NavGroup, ProseCopy, SideNav, TopNav } from '../components/parts';
import { entries } from '../lib/catalog';
import { docsNav, GITHUB_URL } from '../lib/nav';
import { THEME_KEY } from '../lib/theme';

/**
 * The frame: one shell for every page. The bar is the website's navbar (56px, full width,
 * 32px at the sides: the app icon, the pages as text links after it, GitHub, theme and "Get
 * started" at the right). Under it one centred container (~1520px): the page's own sidebar (the
 * same component everywhere, listing only that page's rows), the content, and a rail when the
 * page has one. Every page starts with PageHead at the same offset; no lines between columns.
 */
export type Area = 'docs' | 'components' | 'blocks' | 'playground' | 'themes';
interface Props {
  title: string;
  description: string;
  area: Area;
  /** The sidebar's rows (only this page's own); without them the page has no sidebar. */
  nav?: NavGroup[];
  /** The current sidebar row's href. */
  current?: string;
  /** The sidebar's search placeholder. */
  search?: string;
  /** The sidebar switches the page in place (the Playground). */
  soft?: boolean;
  sections?: SearchItem[];
  /** The content takes its whole column instead of the 760px reading measure. */
  broad?: boolean;
  /** No container: the page spans the window, with the bar's 32px at the sides (a block). */
  full?: boolean;
}
const {
  title,
  description,
  area,
  nav,
  current = '',
  search = 'Search…',
  soft = false,
  sections = [],
  broad = false,
  full = false,
} = Astro.props;
const hasRail = Astro.slots.has('rail');
const PAGES: { id: Area; label: string; href: string }[] = [
  { id: 'docs', label: 'Docs', href: '/docs/introduction' },
  { id: 'components', label: 'Components', href: '/components' },
  { id: 'blocks', label: 'Blocks', href: '/docs/blocks' },
  { id: 'playground', label: 'Playground', href: '/docs/playground' },
  { id: 'themes', label: 'Themes', href: '/docs/themes' },
];

const docs = await docsNav();
const searchItems: SearchItem[] = [
  ...sections,
  ...docs.flatMap((section) =>
    section.items.map((item) => ({
      title: item.title,
      href: item.href,
      group: section.label ?? 'Docs',
    })),
  ),
  ...entries.map((entry) => ({
    title: entry.title,
    href: `/components/${entry.id}`,
    group: 'Components',
  })),
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Wideset</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/_docs/favicon.png" />
    <slot name="head" />
    <script is:inline define:vars={{ THEME_KEY }}>
      try {
        var saved = localStorage.getItem(THEME_KEY);
        var dark =
          saved === 'dark' ||
          ((saved === 'system' || !saved) && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      } catch (e) {}
    </script>
  </head>
  <body class="docs bg-ws-static-foreground">
    <header class="border-ws-static-subtle bg-ws-static-foreground sticky top-0 z-30 flex h-[3.5rem] items-center border-b px-ws-9 sm:px-ws-14">
      {/* The app icon of the website's navbar, at 2x. */}
      <a
        href="/docs/introduction"
        aria-label="Wideset — home"
        class="outline-ws-dynamic-primary-strong-default focus-visible:wds-focus-visible flex shrink-0 items-center rounded-ws-control-md"
      >
        <img src="/_docs/app-icon.png" alt="" width="32" height="32" class="size-[2rem]" />
      </a>
      <TopNav area={area} items={searchItems} github={GITHUB_URL} client:load />
    </header>
    <div
      class:list={[
        'px-ws-9 sm:px-ws-14',
        !full && 'mx-auto max-w-[95rem]',
        // The left column is the sidebar; a page without rows has none (Themes, a block).
        nav && 'lg:grid lg:gap-ws-14',
        nav &&
          // A reading page keeps the rail's column even without a rail, so its content sits at
          // the same x on every such page: the sidebar at the container's left edge, the rail at
          // its right edge, the reading column centred between them.
          (broad
            ? 'lg:grid-cols-[15.25rem_minmax(0,1fr)]'
            : 'lg:grid-cols-[15.25rem_minmax(0,1fr)] xl:grid-cols-[15.25rem_minmax(0,1fr)_12rem]'),
      ]}
    >
      {nav && (
        // Pulled left by the rows' own padding, so their text sits on the logo's edge.
        <aside
          id="docs-nav"
          class="docs-nav sticky top-[3.5rem] -ml-ws-9 hidden h-[calc(100dvh-3.5rem)] overflow-y-auto lg:block"
        >
          <SideNav groups={nav} current={current} placeholder={search} soft={soft} client:load />
        </aside>
      )}
      <main class="min-w-0 pt-ws-14 pb-ws-23">
        <div class:list={[!broad && 'mx-auto w-full max-w-[47.5rem]']}>
          <slot />
        </div>
      </main>
      {nav && hasRail && (
        <aside class="docs-nav sticky top-[3.5rem] hidden h-[calc(100dvh-3.5rem)] self-start overflow-y-auto pt-ws-14 xl:block">
          <slot name="rail" />
        </aside>
      )}
    </div>
    {/* A narrow window: the pages and the page's own list, opened by the bar's menu button. */}
    <div
      id="docs-menu"
      class="bg-ws-static-foreground fixed inset-x-0 top-[3.5rem] bottom-0 z-20 hidden flex-col overflow-y-auto px-ws-9 pt-ws-9 lg:hidden!"
    >
      <nav aria-label="Pages" class="flex flex-wrap gap-x-ws-11 gap-y-ws-5 px-ws-5">
        {PAGES.map((page) => (
          <a
            href={page.href}
            aria-current={page.id === area ? 'page' : undefined}
            class:list={[
              'typography-label-strong-sm no-underline',
              page.id === area ? 'text-ws-static-strong' : 'text-ws-static-subtle',
            ]}
          >
            {page.label}
          </a>
        ))}
      </nav>
      {nav && (
        <div class="min-h-0 flex-1">
          <SideNav
            groups={nav}
            current={current}
            placeholder={search}
            soft={soft}
            className="pt-ws-9 pl-0"
            client:media="(max-width: 1023px)"
          />
        </div>
      )}
    </div>
    <ProseCopy client:idle />
  </body>
</html>
